# MPU-based memory protection
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

# Console on UART0, routed through the on-board FT231X USB-UART (isolated)
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

CONFIG_GPIO=y

# The BC833M has a 32.768 kHz crystal on-module, so the default LFXO
# clock source (CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL) is used unchanged.
